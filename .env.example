# ─────────────────────────────────────────────────────────────────────────────
# Atlas — environment variables
# Copy to .env and fill in. Defaults below are safe for local dev.
# ─────────────────────────────────────────────────────────────────────────────

# === Google Cloud / Vertex / Gemini Enterprise Agent Platform ===
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
# Set to True to route the google-genai SDK through Vertex AI (vs the
# direct Gemini Developer API). Atlas runs everything via Vertex.
GOOGLE_GENAI_USE_VERTEXAI=True
# Firestore emulator (set when running `make dev`). The Firestore client
# auto-routes to localhost when this is set, so you don't need GCP creds locally.
FIRESTORE_EMULATOR_HOST=localhost:8089

# === Gemini model IDs ===
# Pro reasoning tier — used by Discovery and Strategy agents.
GEMINI_MODEL_PRO=gemini-2.5-pro
# Flash tier — used by Designer (text), PM, and Account agents.
GEMINI_MODEL_FLASH=gemini-2.5-flash
# Hero imagery. The Designer agent generates images with Imagen 3
# (`imagen-3.0-generate-001`), set directly in agents/designer/agent.py.
# This var is reserved for a future text-image model swap and is not read today.
GEMINI_MODEL_IMAGE=imagen-3.0-generate-001
# Gemini Live (real-time voice) — reserved for FUTURE voice intake.
# Discovery's run_voice_intake is currently a stub (NotImplementedError);
# intake runs via the web form / transcript instead.
GEMINI_MODEL_LIVE=gemini-live-2.5-flash-native-audio

# === Memory Bank / Agent Engine Sandbox ===
# Resource names look like:
#   projects/PROJECT/locations/LOCATION/reasoningEngines/REASONING_ENGINE_ID
# Leave blank in local dev — Memory Bank falls back to Firestore;
# the sandbox auto-provisions on first call.
MEMORY_BANK_INSTANCE=
ATLAS_SANDBOX_RESOURCE_NAME=

# === Clerk (dashboard auth) ===
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# === Firebase / Firestore (dashboard) ===
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-atlas
NEXT_PUBLIC_FIREBASE_API_KEY=fake-key-for-emulator
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-atlas.firebaseapp.com

# === Inter-agent A2A URLs (local dev defaults; Cloud Run URLs in prod) ===
ATLAS_COORDINATOR_URL=http://localhost:8080
AGENT_URL_COORDINATOR=http://localhost:8080
AGENT_URL_DISCOVERY=http://localhost:8081
AGENT_URL_STRATEGY=http://localhost:8082
AGENT_URL_DESIGNER=http://localhost:8083
AGENT_URL_DEVELOPER=http://localhost:8084
AGENT_URL_PM=http://localhost:8085
AGENT_URL_ACCOUNT=http://localhost:8086

# === Lovable (Developer agent — Build-with-URL API) ===
LOVABLE_API_TOKEN=
LOVABLE_BASE_URL=https://lovable.dev

# === External APIs (agency-mcp tools) ===
# Slack is the one LIVE MCP tool: the PM agent posts the client update via the
# agency-mcp server. If SLACK_BOT_TOKEN is unset, the tool returns a simulated
# success so the pipeline still completes end-to-end.
SLACK_BOT_TOKEN=
SLACK_CHANNEL=#client-updates
# Optional override for how the PM agent spawns the MCP server (default:
# the `mcp-server-agency` entry point installed in the PM image).
# AGENCY_MCP_COMMAND=mcp-server-agency
# Stubbed tools (not wired): provide tokens only if you extend agency-mcp.
SHOPIFY_ACCESS_TOKEN=
STRIPE_API_KEY=
LINEAR_API_KEY=

# === Observability ===
LOG_LEVEL=INFO
